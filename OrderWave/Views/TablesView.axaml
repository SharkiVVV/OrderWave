<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm ="using:OrderWave.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:components="using:OrderWave.Views.Components"
             x:Class="OrderWave.Views.TablesView"
             x:DataType="vm:TablesViewModel"
             Background="#0E1621">
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="24,16" Background="#0E1621">
                <Grid>
                    <TextBlock Text="Hall"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="+ Add Table"
                            Command="{Binding ShowAddTablePanelCommand}"
                            IsVisible="{Binding IsAdmin}"
                            Background="RoyalBlue"
                            Padding="14,8"
                            HorizontalAlignment="Right"/>
                </Grid>
                
            </Border>
            
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding ErrorMessage}"
                       Foreground="OrangeRed"
                       Margin="24,4"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"/>
            
            <TextBlock DockPanel.Dock="Top"
                       Text="load.'.'."
                       Foreground="Gray"
                       Margin="24,4"
                       IsVisible="{Binding IsBusy}"/>
            
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Tables}" Margin="14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TableCardViewModel">
                            <components:TableCardView Margin="10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        
<!--         <Grid IsVisible="{Binding IsAddTablePanelVisible}" Background="#80000000"> -->
