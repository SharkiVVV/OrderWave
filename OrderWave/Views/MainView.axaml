<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OrderWave.ViewModels"
             xmlns:components="using:OrderWave.Views.Components"
             x:Class="OrderWave.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#0E1621">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <components:NavPanelView Grid.Column="0" Width = "99"
                                 IsVisible = "{Binding IsNavVisible}"/>
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
    </Grid>
    

</UserControl>
